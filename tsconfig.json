{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@safetrace/shared": ["src/shared/src/index.ts"],
      "@safetrace/gateway": ["src/gateway/src/index.ts"],
      "@safetrace/ingest": ["src/ingest/src/index.ts"],
      "@safetrace/enrich": ["src/enrich/src/index.ts"],
      "@safetrace/qa": ["src/qa/src/index.ts"]
    }
  },
  "include": ["src/*/src/**/*.ts", "src/*/test/**/*.ts", "scripts/**/*.ts"],
  "exclude": ["node_modules", "**/dist"]
}
