#!/usr/bin/env bash
# 推送前门禁：与 CI 同口径（docs/GITHUB-FLOW.md 第七节）
# 失败即阻断 push；紧急绕过：git push --no-verify（事后补 PR + CI 复核）
set -uo pipefail
ROOT=$(git rev-parse --show-toplevel)
cd "$ROOT"

if [ ! -d node_modules ]; then
  echo "[pre-push] 未安装依赖：请先 npm install" >&2
  exit 1
fi

echo "[pre-push] 1/3 typecheck ..."
npm run typecheck || exit 1

echo "[pre-push] 2/3 test ..."
npm run test || exit 1

echo "[pre-push] 3/3 validate:contracts ..."
if command -v python >/dev/null 2>&1; then
  python scripts/validate_contracts.py || exit 1
else
  echo "[pre-push] 警告：本机无 python，跳过契约校验（CI 仍会拦截）" >&2
fi

echo "[pre-push] 本地门禁通过，允许推送"
exit 0
