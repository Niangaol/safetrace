#!/usr/bin/env bash
# 推送前门禁：与 CI 同口径（docs/GITHUB-FLOW.md 第七节）
# 失败即阻断 push；紧急绕过：git push --no-verify（事后补 PR + CI 复核）
set -uo pipefail
ROOT=$(git rev-parse --show-toplevel)
cd "$ROOT"

if [ ! -d node_modules ]; then
  echo "[pre-push] 未安装依赖：请先 npm install" >&2
  exit 1
fi

echo "[pre-push] 1/3 typecheck ..."
npm run typecheck || exit 1

echo "[pre-push] 2/3 test ..."
npm run test || exit 1

echo "[pre-push] 3/3 validate:contracts ..."
# 2026-09-29 修正：原写法只认 python，在 macOS / 只装了 python3 的机器上
# 会静默跳过第三步——"本地门禁通过"是假的。改为先探 python3 再回落 python，
# 与 package.json 的 validate:contracts 同一套口径。
PY_BIN=$(command -v python3 || command -v python || true)
if [ -z "$PY_BIN" ]; then
  echo "[pre-push] 本机既无 python3 也无 python，契约校验无法本地执行（CI 仍会拦截）" >&2
  exit 1
fi
"$PY_BIN" scripts/validate_contracts.py || exit 1

echo "[pre-push] 本地门禁通过，允许推送"
exit 0
