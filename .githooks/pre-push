#!/usr/bin/env bash
# 推送前门禁：与 CI 同口径（docs/GITHUB-FLOW.md 第七节）
# 失败即阻断 push；紧急绕过：git push --no-verify（事后补 PR + CI 复核）
set -uo pipefail
ROOT=$(git rev-parse --show-toplevel)
cd "$ROOT"

if [ ! -d node_modules ]; then
  echo "[pre-push] 未安装依赖：请先 npm install" >&2
  exit 1
fi

echo "[pre-push] 1/3 typecheck ..."
npm run typecheck || exit 1

echo "[pre-push] 2/3 test ..."
npm run test || exit 1

echo "[pre-push] 3/3 validate:contracts ..."
# 2026-09-29 二次修正：PR #1 的双探写法（command -v python3 || command -v python）
# 在 Windows 的 npm/cmd 口径下根本不可用（command -v 不存在），cmd 下 npm run check
# 实际 exit 1，而台账误记"首次 exit 0"——假绿；且 Git bash 里 command -v python3
# 可能命中 Microsoft Store 占位别名（找得到、跑不了）。改为统一走 Node 跨平台入口：
# 真跑验证式探测 + 退出码透传 + 无解释器显式失败，与 package.json 完全同一实现。
node scripts/validate-contracts.mjs || exit 1

echo "[pre-push] 本地门禁通过，允许推送"
exit 0
