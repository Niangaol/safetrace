# ===== 应用 =====
APP_ENV=dev
LOG_LEVEL=INFO
API_TOKEN=change-me-in-prod

# ===== 基础设施 =====
POSTGRES_DSN=postgresql+psycopg://intel:intel@postgres:5432/intel
REDIS_URL=redis://redis:6379/0
# ⚠️ EMBEDDING_DIM 在下方「Embedding / Reranker」段统一设置（避免两处重复冲突）

# ===== LLM 路由（成本治理核心，见 docs/设计文档.md 第 10 章）=====
LLM_PROVIDER=deepseek
# ⚠️ 模型 ID 必须与服务端真实存在的名字一致。2026-09-29 实测
#    GET https://api.deepseek.com/models → id 为 "deepseek-flash" 与 "deepseek-v4-pro"。
#    曾误写成 deepseek-v4-flash（不存在），配好 key 后 flash 档会被 400 顶回。
LLM_FLASH_MODEL=deepseek-flash
LLM_PRO_MODEL=deepseek-v4-pro
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com

# 本地兜底（主备切换 / 断网演示 / 预算熔断后降级）
# 本机没装 Ollama：留 true 会在云端失败时尝试连 localhost:11434 并白等一轮，
# 因此本地演示建议置 false，让失败点更早暴露。
LLM_LOCAL_ENABLED=false
LLM_LOCAL_BASE_URL=http://localhost:11434
LLM_LOCAL_MODEL=qwen2.5:7b-instruct

# 思考模式开关：抽取/分类类任务一律 false（思考 token 按输出计费，会放大 2~3 倍成本）
LLM_THINKING_DEEP=false

# 前缀缓存：固定 system prompt + few-shot 放在最前，命中价约为未命中的 1/30
LLM_CACHE_ENABLED=true

# 成本闸门
COST_DAILY_BUDGET_CNY=20.0
COST_WARN_RATIO=0.8
COST_TRACKER_PATH=./data/cost.jsonl

# ===== Embedding / Reranker =====
# 后端二选一：
#   onnx  —— ONNX Runtime，**不需要 torch**（依赖约 15MB），推荐。本机 huggingface.co
#            不可达，权重经 hf-mirror.com（实测可达）下载：
#              python -m scripts.fetch_embedding_model --model multilingual-minilm
#            模型落在 data/models/（113MB，已 gitignore）。
#   local —— sentence-transformers，需要 torch（约 2.5GB）。已装 torch 的环境用它。
# ⚠️ 两者产出的向量**不可混用**；`EMBEDDING_DIM` 必须与所选模型一致，
#    且 `db/models.py::EMBED_DIM` 是**导入时**求值的，换维度需重建索引。
EMBEDDING_BACKEND=onnx
# onnx 多语言 MiniLM=384 ｜ bge-small-zh=512 ｜ bge-m3=1024
EMBEDDING_DIM=384
EMBEDDING_MODEL=BAAI/bge-m3
RERANKER_MODEL=BAAI/bge-reranker-v2-m3

# ===== 告警 =====
ALERT_WEBHOOK_URL=

# ===== 采集 =====
COLLECT_USER_AGENT=ai-threat-intel/0.1 (coursework; contact: team@example.com)
COLLECT_INTERVAL_MINUTES=30
COLLECT_FULL_SYNC_WEEKDAY=0

# ===== Webhook / 第三方 API =====
# GitHub security advisory webhook 的 HMAC 密钥（X-Hub-Signature-256 校验用）
GITHUB_WEBHOOK_SECRET=
# GitHub PAT（public_repo 即可）：GraphQL 端点必须鉴权，没有它 GHSA 源会被跳过
GITHUB_TOKEN=
