# ============ SafeTrace 本地配置样例 ============
# 用法：cp .env.example .env 后填入真实值；.env 已被 .gitignore，严禁提交真实密钥
# 原则：所有密钥只走环境变量，代码与配置文件中只允许出现 env 引用名

# ---- 数据源 ----
# NVD API key（免费申请：https://nvd.nist.gov/developers/request-an-api-key）
# 无 key 时限流 5 req/30s；有 key 50 req/30s。留空则网关走限流慢速模式
NVD_API_KEY=
NVD_API_BASE=https://services.nvd.nist.gov/rest/json/cves/2.0

# ---- 单页受控采集（默认关闭；只允许精确 host allowlist）----
FIRECRAWL_ENABLED=false
FIRECRAWL_ALLOWED_HOSTS=
FIRECRAWL_API_KEY=
FIRECRAWL_BASE_URL=https://api.firecrawl.dev/v2/scrape
FIRECRAWL_API_HOSTS=api.firecrawl.dev
# 单页 DQ1 入库另行 opt-in；元数据文件由操作方核对来源/发布日期/可靠性，不自动推断
PAGE_INGEST_ENABLED=false
PAGE_INGEST_METADATA=

# ---- MG1 模型网关（默认离线；真实配置必须显式选择）----
MODELS_CONFIG_PATH=config/models.yml
# 真实 embedding + StepPlan Q&A profile: 设 MODELS_CONFIG_PATH=config/models.tokendance.yml；密钥仅写忽略的 .env.local
TOKENDANCE_BASE_URL=https://tokendance.space/gateway/v1
TOKENDANCE_API_KEY=
STEPPLAN_BASE_URL=https://api.stepfun.com/step_plan/v1
STEP_PLAN_API_KEY=
# DeepSeek（OpenAI 兼容）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# GLM 智谱（OpenAI 兼容）
GLM_API_KEY=
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# 本地 vLLM（OpenAI 兼容服务，可选）
VLLM_BASE_URL=http://127.0.0.1:8000/v1
VLLM_API_KEY=EMPTY
# 本地 Ollama（OpenAI 兼容，实验性）
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_API_KEY=EMPTY

# ---- 基础设施（docker compose 起好后默认值即可）----
QDRANT_URL=http://127.0.0.1:6333
# 仅演示用途：以当前真实 embedder 将 fixtures 写入 Qdrant；不要当作生产知识源
QDRANT_SEED_FIXTURES=false
DATABASE_URL=postgres://safetrace:safetrace@127.0.0.1:5432/safetrace
# 本地 SQLite 模式（无 Docker 时由 store.ts 自动使用）
SQLITE_PATH=./var/safetrace.sqlite

# ---- 可观测（Langfuse，可选）----
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://127.0.0.1:3000

# ---- 运行模式 ----
# offline=true 时冒烟/演示只读 fixtures，绝不发起外网请求
OFFLINE_FIXTURES=false
# ingest:once 默认离线；改为 false 才会请求已登记官方数据源
SAFETRACE_INGEST_OFFLINE=true
# 来源向量入库另行 opt-in；仅非离线、无 fixture 降级且真实 embedder 配置有效时可写
SAFETRACE_INDEX_QDRANT=false
# ingest 入库默认 safetrace_sources；qa:serve 查询时也应设置相同集合
QDRANT_COLLECTION=safetrace_sources

# ---- Q2 检索指向哪个集合（本地真实情报库）----
# QDRANT_URL 一经配置，createDefaultEngine 就走 QdrantEngine；未配则退回 MemoryIndex+fixture。
# safetrace_intel_demo = 用 scripts/index-intel-to-qdrant.ts 从 var/safetrace.sqlite 的
# 真实采集情报灌出来的集合（DQ1 放行 + 本地 bge-m3 向量）。灌库命令：
#   node --env-file=.env.local --import tsx scripts/index-intel-to-qdrant.ts
# 想跑离线 fixture 演示就把 QDRANT_URL 整行删掉/注释掉。
QDRANT_URL=http://127.0.0.1:6333
# QDRANT_COLLECTION=safetrace_intel_demo
