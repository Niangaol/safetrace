# ============ SafeTrace 本地配置样例 ============
# 用法：cp .env.example .env 后填入真实值；.env 已被 .gitignore，严禁提交真实密钥
# 原则：所有密钥只走环境变量，代码与配置文件中只允许出现 env 引用名

# ---- 数据源 ----
# NVD API key（免费申请：https://nvd.nist.gov/developers/request-an-api-key）
# 无 key 时限流 5 req/30s；有 key 50 req/30s。留空则网关走限流慢速模式
NVD_API_KEY=
NVD_API_BASE=https://services.nvd.nist.gov/rest/json/cves/2.0

# ---- MG1 模型网关（provider 切换见 config/models.yml）----
# DeepSeek（OpenAI 兼容）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# GLM 智谱（OpenAI 兼容）
GLM_API_KEY=
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# 本地 vLLM（OpenAI 兼容服务，可选）
VLLM_BASE_URL=http://127.0.0.1:8000/v1
VLLM_API_KEY=EMPTY
# 本地 Ollama（OpenAI 兼容，实验性）
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_API_KEY=EMPTY

# ---- 基础设施（docker compose 起好后默认值即可）----
QDRANT_URL=http://127.0.0.1:6333
DATABASE_URL=postgres://safetrace:safetrace@127.0.0.1:5432/safetrace
# 本地 SQLite 模式（无 Docker 时由 store.ts 自动使用）
SQLITE_PATH=./var/safetrace.sqlite

# ---- 可观测（Langfuse，可选）----
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://127.0.0.1:3000

# ---- 运行模式 ----
# offline=true 时冒烟/演示只读 fixtures，绝不发起外网请求
OFFLINE_FIXTURES=false
