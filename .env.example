# ===== 应用 =====
APP_ENV=dev
LOG_LEVEL=INFO
API_TOKEN=change-me-in-prod

# ===== 基础设施 =====
POSTGRES_DSN=postgresql+psycopg://intel:intel@postgres:5432/intel
REDIS_URL=redis://redis:6379/0
EMBEDDING_DIM=1024

# ===== LLM 路由（成本治理核心，见 docs/设计文档.md 第 10 章）=====
LLM_PROVIDER=deepseek
LLM_FLASH_MODEL=deepseek-v4-flash
LLM_PRO_MODEL=deepseek-v4-pro
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com

# 本地兜底（主备切换 / 断网演示 / 预算熔断后降级）
LLM_LOCAL_ENABLED=true
LLM_LOCAL_BASE_URL=http://ollama:11434
LLM_LOCAL_MODEL=qwen2.5:7b-instruct

# 思考模式开关：抽取/分类类任务一律 false（思考 token 按输出计费，会放大 2~3 倍成本）
LLM_THINKING_DEEP=false

# 前缀缓存：固定 system prompt + few-shot 放在最前，命中价约为未命中的 1/30
LLM_CACHE_ENABLED=true

# 成本闸门
COST_DAILY_BUDGET_CNY=20.0
COST_WARN_RATIO=0.8
COST_TRACKER_PATH=./data/cost.jsonl

# ===== Embedding / Reranker（本地，0 API 费用）=====
EMBEDDING_BACKEND=local
EMBEDDING_MODEL=BAAI/bge-m3
RERANKER_MODEL=BAAI/bge-reranker-v2-m3

# ===== 告警 =====
ALERT_WEBHOOK_URL=

# ===== 采集 =====
COLLECT_USER_AGENT=ai-threat-intel/0.1 (coursework; contact: team@example.com)
COLLECT_INTERVAL_MINUTES=30
COLLECT_FULL_SYNC_WEEKDAY=0

# ===== Webhook / 第三方 API =====
# GitHub security advisory webhook 的 HMAC 密钥（X-Hub-Signature-256 校验用）
GITHUB_WEBHOOK_SECRET=
# GitHub PAT（public_repo 即可）：GraphQL 端点必须鉴权，没有它 GHSA 源会被跳过
GITHUB_TOKEN=
