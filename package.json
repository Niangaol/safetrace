{
  "name": "safetrace",
  "version": "0.1.0",
  "private": true,
  "description": "SafeTrace · 智能体驱动的 AI 安全知识情报系统（中国电子杯 赛题九）P0 骨架",
  "license": "UNLICENSED",
  "type": "module",
  "workspaces": [
    "src/shared",
    "src/gateway",
    "src/ingest",
    "src/enrich",
    "src/qa",
    "src/assets"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "node --import ./scripts/test-network-guard.mjs --import tsx --test --test-concurrency=2 \"src/**/*.test.ts\"",
    "test:live": "node --import tsx --test \"src/gateway/test/*.live.ts\"",
    "typecheck": "tsc -p tsconfig.json",
    "validate:contracts": "node scripts/validate-contracts.mjs",
    "check": "npm run typecheck && npm run test && npm run validate:contracts && npm run check:web",
    "check:web": "npm ci --prefix web && npm run build --prefix web",
    "smoke": "node --import ./scripts/test-network-guard.mjs --import tsx scripts/smoke.ts",
    "assets:demo": "node --import tsx scripts/demo-assets.ts",
    "gateway:serve": "tsx src/gateway/src/server.ts",
    "qa:serve": "tsx src/qa/src/server.ts",
    "qa:decision:serve": "node --env-file-if-exists=.env.local --import tsx scripts/qa-decision-server.ts",
    "llm:context": "node --env-file-if-exists=.env.local --import tsx scripts/llm-context.ts",
    "crawl:page": "node --env-file-if-exists=.env.local --import tsx scripts/crawl-page.ts",
    "demo:serve": "node --env-file-if-exists=.env.local --import tsx scripts/local-demo-server.ts",
    "cli:ask": "tsx src/qa/src/cli.ts",
    "new-branch": "bash scripts/new-branch.sh",
    "hooks:install": "git config core.hooksPath .githooks && chmod +x .githooks/commit-msg .githooks/pre-push",
    "trace:lineage": "tsx scripts/trace-lineage.ts",
    "backup:intel": "node --import tsx scripts/backup-intel.ts",
    "knowledge:preview": "node --import ./scripts/test-network-guard.mjs --import tsx scripts/knowledge-preview.ts",
    "serve:live": "node --import tsx scripts/live-intel-server.ts",
    "enrich:evaluate": "node --import ./scripts/test-network-guard.mjs --import tsx scripts/enrich-evaluate.ts",
    "enrich:captured:cvss": "node --import ./scripts/test-network-guard.mjs --import tsx scripts/reconcile-captured-cvss.ts",
    "remediation:preview": "node --import ./scripts/test-network-guard.mjs --import tsx scripts/remediation-preview.ts",
    "ingest:once": "tsx scripts/ingest-once.ts",
    "assets:scan": "node --import tsx scripts/assets-scan.ts",
    "enrich:pending": "node --env-file-if-exists=.env.local --import tsx scripts/enrich-pending.ts",
    "review:queue": "tsx scripts/review-queue.ts",
    "page:demo": "tsx scripts/demo-page-ingest.ts",
    "pilot:doctor": "tsx scripts/pilot-doctor.ts",
    "embedding:verify": "node --env-file=.env.local --import tsx scripts/verify-live-embedding.ts",
    "vector:verify": "node --env-file=.env.local --import tsx scripts/verify-vector-pipeline.ts",
    "local:up": "pwsh -NoProfile -File scripts/local/up.ps1",
    "local:down": "pwsh -NoProfile -File scripts/local/down.ps1",
    "local:bootstrap": "pwsh -NoProfile -File scripts/local/bootstrap.ps1"
  },
  "devDependencies": {
    "@types/node": "^24",
    "tsx": "^4",
    "typescript": "^5"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
