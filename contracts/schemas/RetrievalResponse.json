{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://safetrace.local/contracts/RetrievalResponse.json",
  "title": "RetrievalResponse",
  "description": "检索响应：带引用的证据包（Q2 → Q3/Q4）。只暴露 EvidenceSet，不暴露存储细节。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "query_id",
    "chunks",
    "retrieval_ms",
    "embedder_model_id",
    "trace_id",
    "schema_version"
  ],
  "properties": {
    "query_id": {
      "type": "string"
    },
    "chunks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "chunk_id",
          "doc_type",
          "text",
          "provenance",
          "score_rerank"
        ],
        "properties": {
          "chunk_id": {
            "type": "string"
          },
          "doc_type": {
            "type": "string",
            "enum": [
              "vuln_advisory",
              "vendor_advisory",
              "paper",
              "standard",
              "policy",
              "enrichment"
            ]
          },
          "text": {
            "type": "string"
          },
          "score_dense": {
            "type": "number"
          },
          "score_sparse": {
            "type": "number"
          },
          "score_rerank": {
            "type": "number"
          },
          "published_at": {
            "type": "string",
            "format": "date-time",
            "description": "上游首次发布时间（来自 RawDoc 对应的 IntelItem.published_at，未归一化前不入库）。缺省 = 发布时间未知，调用方必须按未知处理，不得假定新鲜"
          },
          "trust": {
            "type": "string",
            "enum": ["trusted", "untrusted"],
            "description": "证据信任级：trusted = 结构化权威源（NVD/KEV/CVE.org/OSV/GHSA/arXiv 等 API 直读）或本系统由其派生；untrusted = 网页/文档类外部文本（厂商公告页、社区、PoC）。缺省 = 未知，不得当作 trusted 使用"
          },
          "quality_score": {
            "type": "number",
            "description": "DQ1 判定分，degrade 条目随答案标注"
          },
          "provenance": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "url",
              "section"
            ],
            "properties": {
              "url": {
                "type": "string",
                "format": "uri"
              },
              "section": {
                "type": "string"
              },
              "page": {
                "type": "integer"
              },
              "sha256": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "retrieval_ms": {
      "type": "integer",
      "minimum": 0
    },
    "embedder_model_id": {
      "type": "string",
      "description": "S3 索引-模型绑定：本次检索所用嵌入模型"
    },
    "degraded_to": {
      "type": "string",
      "description": "降级通道（如 memory_index），非空即显式降级"
    },
    "trace_id": {
      "type": "string"
    },
    "schema_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+$"
    }
  }
}
