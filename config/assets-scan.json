{
  "_comment": "本地资产扫描配置（分组模型 v2）。groups 仅在 var/assets.sqlite 的 groups 表为空时播种一次；之后以 Web 资产页/API 管理为准。roots 支持相对仓库根与绝对路径。",
  "groups": [
    {
      "id": "safetrace",
      "name": "SafeTrace 本仓库",
      "roots": ["."],
      "enabled": true,
      "note": "竞赛主工程"
    },
    {
      "id": "agentprograms",
      "name": "AgentPrograms 项目群",
      "roots": [".."],
      "enabled": true,
      "note": "本机其他项目聚集地"
    }
  ],
  "limits": {
    "maxDepth": 6,
    "maxRepos": 400,
    "maxReposPerRoot": 100,
    "maxComponents": 5000,
    "manifestDepth": 5,
    "maxManifestFilesPerRepo": 60,
    "maxManifestBytes": 1048576,
    "timeoutMs": 120000
  },
  "skipDirNames": []
}
