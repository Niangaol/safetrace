# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.mypy_cache/
.ruff_cache/
.pytest_cache/
.coverage
htmlcov/

# 环境与密钥
# ⚠️ 只写 `.env` / `.env.local` 会漏掉 `.env.bak`、`.env.env.bak`、`.env.tmp`
#    这类**备份/临时文件**，而备份里同样有真实密钥。
#    实测踩过：配置界面写 .env 时生成的备份被误提交并推送了。
#    注意 `.env.*` 这个 glob **匹配不到 `.env.env.bak`**（`*` 跨不过中间那个 `.`），
#    所以必须用 `.env*` 整类挡掉。
.env*
# 需要入库的例外（顺序必须在上面那条之后，否则会被吃掉）
!.env.example
!web/.env.example

# 运行日志（含本机路径与配置回显，不入库）
*.log

# 安装包（体积大、可从上游重下，绝不入库）
# 实测踩过：wsl.2.7.14.0.x64.msi 有 247MB，差点被 git add -A 带进去
*.msi
*.msix
*.msixbundle
*.exe
*.dll

# 运行数据
data/
*.sqlite3
var/

# ONNX 嵌入模型（113MB，可从 hf-mirror 重下，绝不入库）
# 重新获取：python -m scripts.fetch_embedding_model --model multilingual-minilm
# （本机 huggingface.co 不可达，脚本走实测可达的 hf-mirror.com）
data/models/
*.onnx

# 前端
web/node_modules/
web/dist/

# 评测产物（可重生成，不入库）
eval/artifacts/
reports/*.pdf
reports/*.docx
reports/*.pptx
