# 依赖与构建
node_modules/
dist/
*.tsbuildinfo

# 密钥与本地配置（严禁入库）
.env
.env.local
!.env.example

# ============================================================
# 本地推理基建：二进制与模型体积大，不进仓库。
# 一键获取：pwsh scripts/local/bootstrap.ps1
# 说明文档：docs/LOCAL-STACK.md
# ============================================================
third_party/
qdrant_data/
qdrant-storage/
.qdrant-initialized
!third_party/.gitkeep

# 本地模型默认放 D:\AgentPrograms\safetrace-models（仓库外）；
# 若放在仓库内则忽略该目录：
local-models/
*.gguf

# 本地数据（SQLite/Qdrant/Langfuse 运行产物）
*.sqlite
*.sqlite-*
*.db
qdrant_data/
.langfuse/
ops/data/
data/

# Private model settings and encryption key
var/runtime-settings/

# 运行日志与临时
*.log
tmp/
.tmp/
.DS_Store
Thumbs.db

# 测试与覆盖率
coverage/
.nyc_output/

# 演示录像与交件材料不进仓库（体积大且含脱敏审校流程）
*.mp4
recordings/
